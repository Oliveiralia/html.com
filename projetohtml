<!DOCTYPE html>
<html>
<head>
    <title>Meu Primeiro Jogo</title>
    <style>
        #player {
            width: 50px;
            height: 50px;
            background-color: blue;
            position: absolute;
            left: 0px;
            top: 0px;
        }
    </style>
</head>
<body>
    <div id="player"></div>
    <script>
        // Aqui vai o nosso JavaScript
    </script>
</body>
</html>
 const player = document.getElementById('player');
let x = 0;
let y = 0;

document.addEventListener('keydown', (event) => {
    switch (event.key) {
        case 'ArrowLeft':
            x -= 10;
            break;
        case 'ArrowRight':
            x += 10;
            break;
        case 'ArrowUp':
            y -= 10;
            break;
        case 'ArrowDown':
            y += 10;
            break;
    }
    player.style.left = x + 'px';
    player.style.top = y + 'px';
});